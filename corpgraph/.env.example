# Development defaults. Never commit a populated .env file.
CORPGRAPH_ENV=development
CORPGRAPH_QUERY_TIMEOUT_MS=30000
CORPGRAPH_RATE_LIMIT_PER_MINUTE=120
CORPGRAPH_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-local-secret
NEO4J_DATABASE=neo4j
REDIS_URL=redis://localhost:6379

# Required in production; generate at least 32 cryptographically random characters.
# CORPGRAPH_API_KEY=
# CORPGRAPH_SITE_ADDRESS=:8080
# CORPGRAPH_PORT=8080
